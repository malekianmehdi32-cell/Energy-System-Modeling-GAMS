  34   
  35  Scalar cop_cooling /3.0/;
  36   
  37  Loop(y,
  38     ElecDemand(y,sea,per) = (ElecDemand0(sea,per) + (CoolDemand0(sea,per)/cop_cooling)) * (1.01)**(ord(y)-1);
  39     HeatDemand(y,sea,per) = HeatDemand0(sea,per) * (1.01)**(ord(y)-1);
  40  );
  41   
  42  SolarCF("nime1","day")   = 0.26;
  43  SolarCF("nime1","night") = 0;
  44  SolarCF("nime2","day")   = 0.12;
  45  SolarCF("nime2","night") = 0;
