  76   OandM("ElecWaterHeater") = 5;
  77   Lifetime("ElecWaterHeater") = 12;
  78   Efficiency("ElecWaterHeater") = 0.97;
  79   AF("ElecWaterHeater") = 0.95;
  80   MaxCap("ElecWaterHeater") = 3000;
  81   
  82  Scalar r /0.07/ ;
  83  Parameter CRF(tech);
  84  CRF(tech) = r*(1+r)**Lifetime(tech) / ((1+r)**Lifetime(tech)-1);
  85   
