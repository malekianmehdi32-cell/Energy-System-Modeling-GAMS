  87  SubVarCost("electricity") = 0.09 ;
  88  SubVarCost("gas")         = 0.03;
  89  InvestCostso("electricity") = 2000;
  90  InvestCostso("gas") = 3000;
  91   
  92   
  93  Positive Variables
  94  Cap(tech)
  95  PVgen(sea,per,y)
  96  CHPelec(sea,per,y)
  97  CHPheat(sea,per,y)
  98  BoilerHeat(sea,per,y)
  99  ElecWH_Heat(sea,per,y)
 100  GridElecBuy(sea,per,y)
 101  GridGasBuy(sea,per,y);
 102   
 103  Variable z;
 104   
 105  Equations
 106  ElecBalance(sea,per,y)
 107  HeatBalance(sea,per,y)
 108  PV_limit(sea,per,y)
 109  CHP_MinElec(sea,per,y)
 110  CHP_MaxElec(sea,per,y)
 111  CHP_UpperHeat(sea,per,y)
 112  CHP_LowerHeat(sea,per,y)
 113  Boiler_limit(sea,per,y)
 114  ElecWH_limit(sea,per,y)
 115  Gas_balance(sea,per,y)
 116  M;
 117   
 118  ElecBalance(sea,per,y)..
 119      PVgen(sea,per,y) + CHPelec(sea,per,y) + GridElecBuy(sea,per,y) =e= ElecDemand(y,sea,per) + ElecWH_Heat(sea,per,y)/Efficiency("ElecWaterHeater");
 120   
 121  HeatBalance(sea,per,y)..
 122      CHPheat(sea,per,y) + BoilerHeat(sea,per,y) + ElecWH_Heat(sea,per,y) =e= HeatDemand(y,sea,per);
 123   
 124  PV_limit(sea,per,y)..
 125      PVgen(sea,per,y) =l= Cap("PV")*SolarCF(sea,per)*AF("PV");
 126   
 127  CHP_MinElec(sea,per,y)..
 128      CHPelec(sea,per,y) =g= (100/700) * Cap("CHP");
 129   
 130  CHP_MaxElec(sea,per,y)..
 131      CHPelec(sea,per,y) =l= Cap("CHP") * AF("CHP");
 132   
 133  CHP_UpperHeat(sea,per,y)..
 134      CHPheat(sea,per,y) =l= 1.3 * CHPelec(sea,per,y);
 135   
 136  CHP_LowerHeat(sea,per,y)..
 137      CHPheat(sea,per,y) =g= 0.4 * CHPelec(sea,per,y) - 0.2 * Cap("CHP");
 138   
 139  Boiler_limit(sea,per,y)..
 140      BoilerHeat(sea,per,y) =l= Cap("Boiler")*AF("Boiler");
 141   
 142  ElecWH_limit(sea,per,y)..
 143      ElecWH_Heat(sea,per,y) =l= Cap("ElecWaterHeater")*AF("ElecWaterHeater");
 144   
 145  Gas_balance(sea,per,y)..
 146      GridGasBuy(sea,per,y) =e= BoilerHeat(sea,per,y)/Efficiency("Boiler") + CHPelec(sea,per,y)/0.35;
 147   
 148  M..
 149      z =e= sum(y, sum((sea,per), (GridElecBuy(sea,per,y)*SubVarCost("electricity") + GridGasBuy(sea,per,y)*SubVarCost("gas")) * Days(sea) * 12))
 150          + InvestCostso("electricity") + InvestCostso("gas")
 151          + sum(tech, Cap(tech)*(InvestCost(tech)*CRF(tech)+OandM(tech)));
 152   
 153  Cap.up(tech) = MaxCap(tech);
 154  Cap.lo("CHP") = 100;
 155   
 156  Model osemosys /all/;
 157  Solve osemosys minimizing z using LP;
 158   
 159  Display z.l, Cap.l;
 160   


