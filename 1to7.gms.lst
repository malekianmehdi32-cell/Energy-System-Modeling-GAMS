 125      PVgen(sea,per,y) =l= Cap("PV")*SolarCF(sea,per)*AF("PV");
 126   
 127  CHP_MinElec(sea,per,y)..
 128      CHPelec(sea,per,y) =g= (100/700) * Cap("CHP");
 129   
 130  CHP_MaxElec(sea,per,y)..
 131      CHPelec(sea,per,y) =l= Cap("CHP") * AF("CHP");
 132   
