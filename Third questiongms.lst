 104   
 105  Equations
 106  ElecBalance(sea,per,y)
 107  HeatBalance(sea,per,y)
 108  PV_limit(sea,per,y)
 109  CHP_MinElec(sea,per,y)
 110  CHP_MaxElec(sea,per,y)
