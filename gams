Sets
   y      "years"   / y1*y7 /
   sea    "Seasons" / nime1, nime2 /
   per    "Periods" / day, night /
   sources "Sources" / electricity, gas /
   tech   "Technologies" / PV, CHP, Boiler, ElecWaterHeater / ;

Parameters
    Days(sea)
    ElecDemand0(sea, per)
    HeatDemand0(sea, per)
    CoolDemand0(sea, per)
    ElecDemand(y,sea,per)
    HeatDemand(y,sea,per)
    SolarCF(sea, per)
    ;


    

Parameter EF(sources),Cap_1(tech),Cap_2taxed(tech),Cap_change(tech);
EF("electricity") = 0.00057;
EF("gas")         = 0.00022;
Scalar z_1, z_2taxed, ExtraCost;
Scalar Emission_1, Emission_2taxed ,Emission_3taxed,CarbonTax;
Positive Variables
GridGasBuy(sea,per,y);

 

Days("nime1")  = 219 ;
Days("nime2")  = 146 ;

ElecDemand0("nime1","day")   = 180 ;
ElecDemand0("nime1","night") = 120 ;
ElecDemand0("nime2","day")   = 180 ;
ElecDemand0("nime2","night") = 120 ;

HeatDemand0("nime1","day")   = 20;
HeatDemand0("nime1","night") = 0;
HeatDemand0("nime2","day")   = 200;
HeatDemand0("nime2","night") = 140;

CoolDemand0("nime1","day")   = 160;
CoolDemand0("nime1","night") = 60;
CoolDemand0("nime2","day")   = 0;
CoolDemand0("nime2","night") = 0;

Scalar cop_cooling /3.0/;

Loop(y,
   ElecDemand(y,sea,per) = (ElecDemand0(sea,per) + (CoolDemand0(sea,per)/cop_cooling)) * (1.01)**(ord(y)-1);
   HeatDemand(y,sea,per) = HeatDemand0(sea,per) * (1.01)**(ord(y)-1);
);

SolarCF("nime1","day")   = 0.26;
SolarCF("nime1","night") = 0;
SolarCF("nime2","day")   = 0.12;
SolarCF("nime2","night") = 0;

Parameters
InvestCost(tech)
OandM(tech)
Lifetime(tech)
Efficiency(tech)
AF(tech)
MaxCap(tech)
MinCap(tech);

InvestCost("PV") = 1000;
OandM("PV") = 15;
 Lifetime("PV") = 25;
 AF("PV") = 0.95;
 MaxCap("PV") = 100;

InvestCost("CHP") = 1500;
 OandM("CHP") = 150;
 Lifetime("CHP") = 20;
 AF("CHP") = 0.8;
 MaxCap("CHP") = 700;

InvestCost("Boiler") = 300;
 OandM("Boiler") = 10;
 Lifetime("Boiler") = 20;
 Efficiency("Boiler") = 0.9;
 AF("Boiler") = 0.95;
 MaxCap("Boiler") = 300;

InvestCost("ElecWaterHeater") = 120;
 OandM("ElecWaterHeater") = 5;
 Lifetime("ElecWaterHeater") = 12;
 Efficiency("ElecWaterHeater") = 0.97;
 AF("ElecWaterHeater") = 0.95;
 MaxCap("ElecWaterHeater") = 3000;

Scalar r /0.07/ ;
Parameter CRF(tech);
CRF(tech) = r*(1+r)**Lifetime(tech) / ((1+r)**Lifetime(tech)-1);

Parameter SubVarCost(sources), InvestCostso(sources);
SubVarCost("electricity") = 0.09 ;
SubVarCost("gas")         = 0.03;
InvestCostso("electricity") = 2000;
InvestCostso("gas") = 3000;


Positive Variables
Cap(tech)
PVgen(sea,per,y)
CHPelec(sea,per,y)
CHPheat(sea,per,y)
BoilerHeat(sea,per,y)
ElecWH_Heat(sea,per,y)
GridElecBuy(sea,per,y)
GridGasBuy(sea,per,y)
;

Variable z;

Equations
ElecBalance(sea,per,y)
HeatBalance(sea,per,y)
PV_limit(sea,per,y)
CHP_MinElec(sea,per,y)
CHP_MaxElec(sea,per,y)
CHP_UpperHeat(sea,per,y)
CHP_LowerHeat(sea,per,y)
Boiler_limit(sea,per,y)
ElecWH_limit(sea,per,y)
Gas_balance(sea,per,y)
M;

ElecBalance(sea,per,y)..
    PVgen(sea,per,y) + CHPelec(sea,per,y) + GridElecBuy(sea,per,y) =e= ElecDemand(y,sea,per) + ElecWH_Heat(sea,per,y)/Efficiency("ElecWaterHeater");

HeatBalance(sea,per,y)..
    CHPheat(sea,per,y) + BoilerHeat(sea,per,y) + ElecWH_Heat(sea,per,y) =e= HeatDemand(y,sea,per);

PV_limit(sea,per,y)..
    PVgen(sea,per,y) =l= Cap("PV")*SolarCF(sea,per)*AF("PV");

CHP_MinElec(sea,per,y)..
    CHPelec(sea,per,y) =g= (100/700) * Cap("CHP");

CHP_MaxElec(sea,per,y)..
    CHPelec(sea,per,y) =l= Cap("CHP") * AF("CHP");

CHP_UpperHeat(sea,per,y)..
    CHPheat(sea,per,y) =l= 1.3 * CHPelec(sea,per,y);

CHP_LowerHeat(sea,per,y)..
    CHPheat(sea,per,y) =g= 0.4 * CHPelec(sea,per,y) - 0.2 * Cap("CHP");

Boiler_limit(sea,per,y)..
    BoilerHeat(sea,per,y) =l= Cap("Boiler")*AF("Boiler");

ElecWH_limit(sea,per,y)..
    ElecWH_Heat(sea,per,y) =l= Cap("ElecWaterHeater")*AF("ElecWaterHeater");

Gas_balance(sea,per,y)..
    GridGasBuy(sea,per,y) =e= BoilerHeat(sea,per,y)/Efficiency("Boiler") + CHPelec(sea,per,y)/0.35;

M..
    z =e=
   sum(y,  sum((sea,per),(  GridElecBuy(sea,per,y)*SubVarCost("electricity")
  + GridGasBuy(sea,per,y)*SubVarCost("gas")
 + CarbonTax *( GridElecBuy(sea,per,y)*EF("electricity")
 + GridGasBuy(sea,per,y)*EF("gas") ) ) * Days(sea) * 12  ))
 + InvestCostso("electricity") + InvestCostso("gas") + sum(tech,
 Cap(tech)*(InvestCost(tech)*CRF(tech) + OandM(tech)));

Cap.up(tech) = MaxCap(tech);
Cap.lo("CHP") = 100;

Parameter Emission_Limit_Value;
Equation Emission_Limit_Eq;
Model osemosys /all/;




Emission_Limit_Eq..
    sum(y, sum((sea,per), (GridElecBuy(sea,per,y)*EF("electricity") + GridGasBuy(sea,per,y)*EF("gas")) * Days(sea) * 12)) =l= Emission_Limit_Value;

CarbonTax = 0;
Emission_Limit_Value = inf;
Solve osemosys minimizing z using LP;
z_1 = z.l;
Cap_1(tech) = Cap.l(tech);
Emission_1 = sum(y,sum((sea,per), ( GridElecBuy.l(sea,per,y)*EF("electricity")
+ GridGasBuy.l(sea,per,y)*EF("gas") )  * Days(sea) * 12 ) );



CarbonTax = 84;
Emission_Limit_Value = inf;
Solve osemosys minimizing z using LP;
z_2taxed = z.l;
Cap_2taxed(tech) = Cap.l(tech);
Emission_2taxed =sum(y,sum((sea,per),
  ( GridElecBuy.l(sea,per,y)*EF("electricity")
 + GridGasBuy.l(sea,per,y)*EF("gas"))* Days(sea) * 12  ) );
z_2taxed = z.l;
Cap_2taxed(tech) = Cap.l(tech);
ExtraCost = z_2taxed - z_1;
Cap_change(tech) = Cap_2taxed(tech) - Cap_1(tech);
Display z_1, z_2taxed, ExtraCost, Cap_1, Cap_2taxed, Cap_change;


CarbonTax = 0;
Emission_Limit_Value = 0.7 * Emission_1;
Solve osemosys minimizing z using LP;
Emission_3taxed =sum(y,sum((sea,per),
  ( GridElecBuy.l(sea,per,y)*EF("electricity")
 + GridGasBuy.l(sea,per,y)*EF("gas"))* Days(sea) * 12  ) );
 
Scalar z_3;
z_3 = z.l;
Display z_3;

